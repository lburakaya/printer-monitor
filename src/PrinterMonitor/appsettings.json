{
  "Urls": "http://localhost:5080",
  "AllowedHosts": "*",
  "Monitor": {
    "DemoMode": true,
    "PollSeconds": 300,
    "TimeoutMs": 2500,
    "Retries": 1,
    "MaxConcurrency": 4,
    "LowThreshold": 20,
    "HistoryDays": 30,
    "DataDirectory": "data",
    "AllowedNetworks": []
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
